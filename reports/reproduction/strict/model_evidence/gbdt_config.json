{
  "model": "gbdt",
  "dataset": "kuairec",
  "feature_columns": [
    "retrieval_score",
    "source_rank",
    "inverse_source_rank",
    "rank",
    "inverse_rank",
    "source_count",
    "item_popularity",
    "log_item_popularity",
    "user_activity_level",
    "log_user_activity_level",
    "history_len",
    "duration_bucket",
    "category_count",
    "tag_count",
    "category_overlap",
    "tag_overlap",
    "category_jaccard",
    "tag_jaccard",
    "history_category_count",
    "history_tag_count",
    "candidate_pool_size",
    "source_has_trend"
  ],
  "source_names": [
    "trend"
  ],
  "exclude_injected_positives": true,
  "max_iter": 120,
  "learning_rate": 0.07,
  "max_leaf_nodes": 31,
  "l2_regularization": 0.05,
  "sample_seed": 42,
  "max_train_rows": 700000,
  "max_val_rows": 500000,
  "train_split": "train",
  "val_split": "val"
}
