{
  "model": "lambdarank",
  "dataset": "kuairec_strict",
  "features_dir": "data/features/kuairec_completion_negatives/exposed_low_watch_negative",
  "train_split": "train",
  "val_split": "val",
  "query_col": "user_id",
  "label_mode": "graded",
  "eval_at": [
    5,
    10,
    20,
    50,
    100
  ],
  "exclude_injected_positives": true,
  "feature_columns": [
    "retrieval_score",
    "source_rank",
    "inverse_source_rank",
    "rank",
    "inverse_rank",
    "source_count",
    "item_popularity",
    "log_item_popularity",
    "user_activity_level",
    "log_user_activity_level",
    "history_len",
    "duration_bucket",
    "category_count",
    "tag_count",
    "category_overlap",
    "tag_overlap",
    "category_jaccard",
    "tag_jaccard",
    "history_category_count",
    "history_tag_count",
    "candidate_pool_size",
    "source_has_trend",
    "author_idx"
  ],
  "source_names": [
    "trend"
  ],
  "n_estimators": 120,
  "learning_rate": 0.05,
  "num_leaves": 31,
  "min_child_samples": 20,
  "subsample": 0.9,
  "colsample_bytree": 0.9,
  "reg_lambda": 0.1,
  "random_state": 42,
  "max_train_rows": 700000,
  "max_val_rows": 500000
}
